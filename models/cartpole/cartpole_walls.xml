<mujoco model="cartpole_walls">
    <include file="cartpole.xml"/>
    
    <!-- Override or add elements here -->
    <worldbody>

        <!-- Left wall (hard contact, raised above cart body so only the pole contacts it) -->
        <body name="left_wall" pos="-0.6 0 1.3">
            <geom name="left_wall" type="box" size="0.1 0.3 0.3" rgba="0.8 0.3 0.3 0.7"
                  contype="1" conaffinity="1"/>
        </body>

        <!-- Right wall (hard contact, raised above cart body so only the pole contacts it) -->
        <body name="right_wall" pos="0.6 0 1.3">
            <geom name="right_wall" type="box" size="0.1 0.3 0.3" rgba="0.3 0.3 0.8 0.7"
                  contype="1" conaffinity="1"/>
        </body>

    </worldbody>
</mujoco>